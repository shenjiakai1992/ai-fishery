# ========== 数据库 ==========
# 本地开发：PostgreSQL 连接串
# 推荐方案（无需本地安装 PG）：Supabase / Neon 免费层
#   例：postgresql://user:password@host:5432/ai-fishery?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/ai_fishery?schema=public"

# ========== 认证 ==========
# JWT 签名密钥（生产环境务必改）
JWT_SECRET="change-this-to-a-long-random-string"
# Token 有效期（默认 7 天）
JWT_EXPIRES_IN="7d"

# ========== 管理员白名单手机号 ==========
# 只有此列表中的手机号可以登录后台（防短信轰炸）
# 多个用逗号分隔，例：13800138000,13900139000
ADMIN_WHITELIST_PHONES="13800138000"

# ========== 阿里云短信 ==========
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""

# ========== 文件存储 ==========
# local = 本地 public/uploads（开发）；oss = 阿里云 OSS（生产）
STORAGE_PROVIDER="local"
# 以下仅 STORAGE_PROVIDER=oss 时需要
ALIYUN_OSS_REGION=""
ALIYUN_OSS_BUCKET=""
ALIYUN_OSS_ACCESS_KEY_ID=""
ALIYUN_OSS_ACCESS_KEY_SECRET=""

# ========== 站点 ==========
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
